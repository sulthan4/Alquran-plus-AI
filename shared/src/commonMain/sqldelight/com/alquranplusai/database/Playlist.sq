-- Playlist table
CREATE TABLE IF NOT EXISTS Playlist (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    description TEXT,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    itemCount INTEGER NOT NULL DEFAULT 0,
    totalDuration INTEGER NOT NULL DEFAULT 0,
    coverImageUrl TEXT,
    isDefault INTEGER NOT NULL DEFAULT 0
);

-- Indexes
CREATE INDEX IF NOT EXISTS idx_playlist_created ON Playlist(createdAt DESC);
CREATE INDEX IF NOT EXISTS idx_playlist_updated ON Playlist(updatedAt DESC);

-- Queries
selectAllPlaylists:
SELECT * FROM Playlist ORDER BY updatedAt DESC;

selectPlaylistById:
SELECT * FROM Playlist WHERE id = ?;

selectDefaultPlaylists:
SELECT * FROM Playlist WHERE isDefault = 1 ORDER BY name;

insertPlaylist:
INSERT OR REPLACE INTO Playlist(
    id, name, description, createdAt, updatedAt,
    itemCount, totalDuration, coverImageUrl, isDefault
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updatePlaylist:
UPDATE Playlist 
SET name = ?, description = ?, updatedAt = ?, coverImageUrl = ?
WHERE id = ?;

updatePlaylistCounts:
UPDATE Playlist 
SET itemCount = ?, totalDuration = ?, updatedAt = ?
WHERE id = ?;

deletePlaylist:
DELETE FROM Playlist WHERE id = ?;
