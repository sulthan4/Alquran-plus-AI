-- BookmarkTag table
CREATE TABLE IF NOT EXISTS BookmarkTag (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL UNIQUE,
    color TEXT,
    usageCount INTEGER NOT NULL DEFAULT 0
);

-- BookmarkTagRelation table (many-to-many)
CREATE TABLE IF NOT EXISTS BookmarkTagRelation (
    bookmarkId TEXT NOT NULL,
    tagId TEXT NOT NULL,
    PRIMARY KEY (bookmarkId, tagId),
    FOREIGN KEY (bookmarkId) REFERENCES Bookmark(id) ON DELETE CASCADE,
    FOREIGN KEY (tagId) REFERENCES BookmarkTag(id) ON DELETE CASCADE
);

-- Indexes
CREATE INDEX IF NOT EXISTS idx_tag_usage ON BookmarkTag(usageCount DESC);
CREATE INDEX IF NOT EXISTS idx_tag_relation_bookmark ON BookmarkTagRelation(bookmarkId);
CREATE INDEX IF NOT EXISTS idx_tag_relation_tag ON BookmarkTagRelation(tagId);

-- Tag Queries
selectAllTags:
SELECT * FROM BookmarkTag ORDER BY name;

selectTagById:
SELECT * FROM BookmarkTag WHERE id = ?;

selectPopularTags:
SELECT * FROM BookmarkTag ORDER BY usageCount DESC LIMIT ?;

selectTagsByBookmark:
SELECT t.* FROM BookmarkTag t
INNER JOIN BookmarkTagRelation r ON t.id = r.tagId
WHERE r.bookmarkId = ?
ORDER BY t.name;

insertTag:
INSERT OR REPLACE INTO BookmarkTag(id, name, color, usageCount)
VALUES (?, ?, ?, ?);

updateTagUsage:
UPDATE BookmarkTag SET usageCount = usageCount + ? WHERE id = ?;

deleteTag:
DELETE FROM BookmarkTag WHERE id = ?;

-- Relation Queries
insertTagRelation:
INSERT OR IGNORE INTO BookmarkTagRelation(bookmarkId, tagId)
VALUES (?, ?);

deleteTagRelation:
DELETE FROM BookmarkTagRelation WHERE bookmarkId = ? AND tagId = ?;

deleteTagRelationsByBookmark:
DELETE FROM BookmarkTagRelation WHERE bookmarkId = ?;

deleteTagRelationsByTag:
DELETE FROM BookmarkTagRelation WHERE tagId = ?;
