-- QuizResult table
CREATE TABLE IF NOT EXISTS QuizResult (
    id TEXT PRIMARY KEY NOT NULL,
    quizId TEXT NOT NULL,
    userId TEXT NOT NULL,
    startedAt INTEGER NOT NULL,
    completedAt INTEGER,
    score INTEGER NOT NULL DEFAULT 0,
    totalPoints INTEGER NOT NULL,
    correctAnswers INTEGER NOT NULL DEFAULT 0,
    wrongAnswers INTEGER NOT NULL DEFAULT 0,
    skippedAnswers INTEGER NOT NULL DEFAULT 0,
    timeSpent INTEGER NOT NULL DEFAULT 0,
    isPassed INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (quizId) REFERENCES Quiz(id) ON DELETE CASCADE
);

-- QuizResultAnswer table
CREATE TABLE IF NOT EXISTS QuizResultAnswer (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    resultId TEXT NOT NULL,
    questionId TEXT NOT NULL,
    userAnswer TEXT,
    correctAnswer TEXT NOT NULL,
    isCorrect INTEGER NOT NULL,
    points INTEGER NOT NULL,
    timeSpent INTEGER NOT NULL,
    FOREIGN KEY (resultId) REFERENCES QuizResult(id) ON DELETE CASCADE
);

-- Indexes
CREATE INDEX IF NOT EXISTS idx_result_user ON QuizResult(userId);
CREATE INDEX IF NOT EXISTS idx_result_quiz ON QuizResult(quizId);
CREATE INDEX IF NOT EXISTS idx_result_completed ON QuizResult(completedAt DESC);
CREATE INDEX IF NOT EXISTS idx_result_answer ON QuizResultAnswer(resultId);

-- QuizResult Queries
selectQuizResult:
SELECT * FROM QuizResult WHERE id = ?;

selectUserQuizResults:
SELECT * FROM QuizResult WHERE userId = ? ORDER BY completedAt DESC;

selectUserQuizAttempts:
SELECT * FROM QuizResult WHERE userId = ? AND quizId = ? ORDER BY completedAt DESC;

selectBestAttempt:
SELECT * FROM QuizResult 
WHERE userId = ? AND quizId = ?
ORDER BY score DESC, completedAt DESC
LIMIT 1;

insertQuizResult:
INSERT OR REPLACE INTO QuizResult(
    id, quizId, userId, startedAt, completedAt,
    score, totalPoints, correctAnswers, wrongAnswers, skippedAnswers,
    timeSpent, isPassed
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateQuizResult:
UPDATE QuizResult 
SET completedAt = ?, score = ?, correctAnswers = ?, wrongAnswers = ?,
    skippedAnswers = ?, timeSpent = ?, isPassed = ?
WHERE id = ?;

deleteQuizResult:
DELETE FROM QuizResult WHERE id = ?;

-- QuizResultAnswer Queries
selectResultAnswers:
SELECT * FROM QuizResultAnswer WHERE resultId = ?;

insertResultAnswer:
INSERT INTO QuizResultAnswer(
    resultId, questionId, userAnswer, correctAnswer,
    isCorrect, points, timeSpent
) VALUES (?, ?, ?, ?, ?, ?, ?);

deleteResultAnswers:
DELETE FROM QuizResultAnswer WHERE resultId = ?;
